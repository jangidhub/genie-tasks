{
  "expo": {
    "name": "To_Do_List",
    "slug": "To_Do_List",
    "scheme": "todogenie",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Genie to use your location to trigger geofence alerts when the app is in the background.",
          "locationAlwaysPermission": "Allow Genie to use your location to trigger geofence alerts when the app is in the background.",
          "locationWhenInUsePermission": "Allow Genie to use your location to drop pins for tasks."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0f751212-6638-4fd2-94f9-d9eded1b2f44"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0f751212-6638-4fd2-94f9-d9eded1b2f44"
    }
  }
}
